# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
.turbo/
dist/
out/
build/
*.tsbuildinfo

# Next.js auto-generates `next-env.d.ts` on every dev/build and rewrites
# its import target each time — keeping it tracked surfaces noisy
# false-positive diffs every session. Next regenerates it as needed.
next-env.d.ts

# Claude Code per-user settings and runtime files
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Generated types — Payload regenerates this; do not edit by hand
# (still committed; ignore only local stale copies during regeneration)
**/payload-types.bak.ts

# Env files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Coverage
coverage/
.nyc_output/

# Migrations local artefacts (ETL outputs are gitignored; scripts are committed)
migrations/webflow-export/
migrations/webflow-import/.cache/

# Payload local uploads (R2 in prod; local fallback during dev)
apps/cms/media/

# Lead fallback queue (R2 in prod; local fs when R2 not configured)
apps/cms/.lead-fallback-queue/

# Sentry
.sentryclirc
.gstack/
.vercel
.env*.local

launch.json
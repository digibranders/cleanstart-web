# Repo-root env template. Copy to `.env` (gitignored) for local dev.
# Per-app envs live next to their app (e.g. apps/cms/.env.example).

# Figma access — used by scripts/figma-extract.ts to extract design tokens
# and snapshots from the CleanStart V4 Figma file into docs/web/.
# Generate a Personal Access Token in Figma → Settings → Personal access tokens
# with at minimum the `file_content:read` scope. If the design file ever
# publishes Figma Variables, also enable `file_variables:read`.
FIGMA_TOKEN=
FIGMA_FILE_KEY=doWR9Xbwgkz6dqR9n4m3BB
FIGMA_HOMEPAGE_NODE=108:7624

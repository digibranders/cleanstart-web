# Base URL of the CMS that receives registrations (POST /api/leads/submit).
NEXT_PUBLIC_CMS_URL=http://localhost:3000
# Cloudflare Turnstile site key. Leave empty locally to skip the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public origin of this site, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3005
# Set to 1 only on the production deploy so search engines may index it.
ALLOW_INDEXING=

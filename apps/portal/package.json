{
  "name": "@cleanstart/portal",
  "version": "0.0.1",
  "description": "CleanStart partner portal (partners.cleanstart.com): deal registration, documents and team management for partners and CleanStart staff.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "SKIP_ENV_VALIDATION=1 next build",
    "start": "next start --port 3004",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed-dev.ts",
    "demo:setup": "tsx --env-file-if-exists=.env.demo.local scripts/demo.ts setup",
    "demo:reset": "tsx --env-file-if-exists=.env.demo.local scripts/demo.ts reset",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "verify:copy": "node scripts/verify-copy.mjs",
    "audit:deps": "node scripts/audit-portal.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@cleanstart/forms": "workspace:*",
    "@hubspot/api-client": "^13.5.0",
    "@sentry/nextjs": "^9.47.2",
    "better-auth": "1.7.22",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "next": "16.4.6",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cleanstart/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}

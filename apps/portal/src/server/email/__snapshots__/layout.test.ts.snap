  [data-ogsc] .cs-heading { color: #0f172a !important; }
  [data-ogsc] .cs-text { color: #334155 !important; }
  [data-ogsc] .cs-btn, [data-ogsb] .cs-btn { background-color: #3960f9 !important; }
  [data-ogsc] .cs-btn a { color: #ffffff !important; }

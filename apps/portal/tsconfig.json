{
  "extends": "@cleanstart/config/tsconfig.next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "incremental": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "*.config.ts", ".next/types/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", ".next", ".turbo", "dist"]
}

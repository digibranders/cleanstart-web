# Local dev — points at host pgAdmin Postgres (not docker-compose).
# Database `cleanstart` created in pgAdmin, owner `postgres`.
DATABASE_URI=postgres://postgres:1234@localhost:5432/cleanstart

# Payload — generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Public URL of this app (used by Payload for absolute URLs in admin UI + emails)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 (Phase B) — leave blank in early dev to fall back to local fs.
# In production all four are required for the media adapter + lead fallback queue.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cleanstart
R2_ENDPOINT=https://394d5e2bbba246d392071093599eba52.r2.cloudflarestorage.com
# Public base URL for served media.
# dev:  https://pub-829c6eb6f64a4b6c8039527d89b4030c.r2.dev
# prod: https://cdn.cleanstart.com
R2_PUBLIC_BASE=
# Top-level folder prefix inside the bucket.
# dev → uploads land under dev/  (local dev & staging)
# web → uploads land under web/  (production)
# Defaults to 'web' when unset so a missing prod var never silently uses dev/.
R2_UPLOAD_PREFIX=

# Cloudflare Turnstile — server-side challenge verification on /api/leads/submit.
# When TURNSTILE_SECRET_KEY is unset, verification is skipped (dev). Production
# needs both keys (real keys are domain-locked and fail on localhost).
# LOCAL TESTING: use Cloudflare's public always-pass test keys, which work on
# any hostname — pair these with NEXT_PUBLIC_TURNSTILE_SITE_KEY in apps/web:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (Phase G)
SENTRY_DSN=

# Meilisearch (Phase F5–F8) — self-hosted search backend.
# When MEILISEARCH_URL is unset, indexing hooks are no-ops (dev /
# offline iteration still works). Production needs all three.
#   MEILISEARCH_URL          : http://localhost:7700 in dev,
#                              http://meilisearch:7700 inside docker compose,
#                              https://search.cleanstart.com in prod.
#   MEILISEARCH_MASTER_KEY   : bootstraps the cluster on first run; required
#                              by docker-compose to start the container.
#   MEILISEARCH_API_KEY      : admin-tier key the CMS uses for indexing
#                              (issued by the master key on first run).
MEILISEARCH_URL=
MEILISEARCH_MASTER_KEY=
MEILISEARCH_API_KEY=

# Webhooks (Phase G) — outbound event notifications.
# When unset, dispatch is a no-op (dev / offline iteration unaffected).
#
# Microsoft Teams Workflows: auth lives in the URL (token-bearing),
# no signing needed. WEBHOOK_TEAMS_EVENTS is an optional comma-list
# filter; defaults to all events (document.published, lead.submitted).
WEBHOOK_TEAMS_URL=
WEBHOOK_TEAMS_EVENTS=
#
# Generic Standard Webhooks subscriber (any HTTP receiver that
# verifies the HMAC signature per https://standardwebhooks.com).
# Both URL and SIGNING_SECRET must be set for the destination to
# activate.
WEBHOOK_GENERIC_URL=
WEBHOOK_GENERIC_EVENTS=
WEBHOOK_GENERIC_SIGNING_SECRET=

# Trusted reverse-proxy chain length for X-Forwarded-For parsing.
# 0 (default) = ignore XFF entirely (safe behind direct attackers).
# 1 = behind a single proxy (e.g. just Caddy).
# 2 = behind two proxies (e.g. Cloudflare → Caddy).
# Required to be >0 ONLY when the deployment fronts the app with a
# trusted proxy stack; otherwise leave at 0 so spoofed XFF can't bypass
# the per-IP rate limit on /api/leads/submit.
TRUSTED_PROXY_HOPS=0

# Comma-separated CORS allow-list for /api/leads/submit. Defaults to
# https://cleanstart.com,https://www.cleanstart.com when unset.
LEAD_SUBMIT_ALLOWED_ORIGINS=

# Comma-separated form slugs exempt from Turnstile on /api/leads/submit —
# email-only signups that don't render a widget (rate limit + honeypot + CORS
# still apply). Defaults to "newsletter,resource-capture" when unset.
LEAD_SUBMIT_TURNSTILE_EXEMPT_SLUGS=

# Rate-limiter backend selection. The in-memory store is single-process
# only — running >1 worker shards the per-IP window and effectively
# multiplies the quota. The CMS fail-fasts at boot when these disagree.
#   memory   (default)  → safe with WEB_CONCURRENCY=1
#   redis    | postgres → safe with any concurrency (backend swap is its own ticket)
RATE_LIMIT_BACKEND=memory
WEB_CONCURRENCY=1

# Comma-separated CORS / CSRF allow-list for the admin REST surface.
# Defaults to the configured serverURL (PAYLOAD_PUBLIC_SERVER_URL).
# In production set to your admin origin (e.g. https://cms.cleanstart.com)
# and any staging origins that need to share auth cookies.
PAYLOAD_CORS_ORIGINS=

# Cron / autoRun gate. The payload jobs runner skips registration when
# this is anything other than 'true', so vitest worker subprocesses
# can't kick off lead-queue drains, PII purges, or broken-link scans
# during a test run. Production deploys should set it to true.
PAYLOAD_AUTO_RUN=false

# Public marketing-site origin used by the CMS for absolute URLs in
# Lexical link-popovers, sitemap and OG cards. NEXT_PUBLIC_SITE_HOSTS
# is a comma-separated list of hostnames the link-popover treats as
# internal (so the popover hides the "external link" warning).
NEXT_PUBLIC_SITE_URL=https://cleanstart.com
NEXT_PUBLIC_SITE_ORIGIN=https://cleanstart.com
NEXT_PUBLIC_SITE_HOSTS=cleanstart.com,www.cleanstart.com

# Display flag surfaced in the admin sidebar to remind editors which
# environment they're in (dev / staging / production). Cosmetic only.
PAYLOAD_PUBLIC_ENV=dev

# When set to 'true' the /robots.txt endpoint returns a global Disallow
# regardless of arch-doc settings. Used to keep staging out of search
# indexes.
PAYLOAD_PUBLIC_ROBOTS_DISALLOW=false

# IndexNow ping key. When set, publish hooks notify Bing / Yandex of
# new and changed URLs. Generate a 32-char alphanumeric value and
# host it at /<key>.txt on the public site (the indexnow handshake).
# When unset the publish hook becomes a no-op.
INDEXNOW_KEY=

# Persistent path for the lead-fallback queue when R2 is unavailable.
# REQUIRED in production — without it, parked submissions can land
# inside the Next build output dir and get wiped on the next deploy.
# Use a mounted volume (e.g. /var/lib/cleanstart/lead-fallback-queue).
LEAD_QUEUE_LOCAL_DIR=

# ─── Phase J integrations (admin-managed via /admin/collections/integrations) ───
#
# These env vars hold the credentials for global integrations. The per-row
# admin UI carries only non-secret destination details (Teams URL, GA4
# property ID, GSC site URL, etc.) — secrets stay in env, not in Postgres.

# HubSpot portal (account) id. Used by the lead handler to relay form
# submissions to the matching HubSpot form via the Forms Submissions API
# (POST submit/{portalId}/{formGuid}). Find it under HubSpot → Settings →
# Account Setup → Account Defaults, or in any app URL (.../HubID/...).
HUBSPOT_PORTAL_ID=

# HubSpot CRM — Private App access token. Only required for the GDPR
# contact-erasure path (contacts gdpr-delete API); the Forms API submit
# endpoint above does not need it. Set once via the HubSpot portal
# (Settings → Integrations → Private Apps → new app with scopes
# crm.objects.contacts.read + crm.objects.contacts.write). No expiry.
HUBSPOT_PRIVATE_APP_TOKEN=

# Google service-account JSON used for BOTH GA4 Data API and Google Search
# Console (Search Analytics + URL Inspection). Paste the entire JSON file
# contents inline. The SA must be granted Viewer on the GA4 property AND
# added as a user on the GSC property.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Microsoft Clarity — Bearer JWT generated per project at
# Clarity → Settings → Data Export → Generate new API token.
CLARITY_API_TOKEN=

# Cloudflare Web Analytics — account API token with
# `Account Analytics: Read`. Optional CLOUDFLARE_ACCOUNT_TAG is the
# account ID (32-char hex); the row can also specify it per-account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_TAG=

# Cal.com inbound webhook signing secret. Set the same value as the
# webhook's signing secret in Cal.com → Settings → Developer → Webhooks.
CALCOM_SIGNING_SECRET=

# ─── Webflow migration (Phase H — one-time only) ──────────────────────────
# Site-level API token from Webflow: site settings → Apps & Integrations → API access.
# Scopes needed: Assets, CMS, Forms, Pages, Sites — all Read-only.
# Do NOT put real values here. Operator should use a local .env.migration file
# (gitignored) that sources these into the shell before running
# migrations/webflow-import/*.ts scripts.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_SITE_URL=https://cleanstart.com
PAYLOAD_URL=http://localhost:3000

# ─── Preview sharing (Phase J · D1) ───────────────────────────────────────
# Public origin of the apps/web marketing site. Used to compose Live
# Preview iframe URLs and shareable preview links. Dev default is the
# Next.js port for apps/web (3001).
WEB_BASE_URL=http://localhost:3001
# Shared secret between the CMS and apps/web for in-admin Live Preview.
# Generate with: openssl rand -base64 32
# Must match the value of LIVE_PREVIEW_SECRET in apps/web/.env.
LIVE_PREVIEW_SECRET=
# HS256 signing key for shareable preview-link JWTs. Min 32 chars.
# Generate with: openssl rand -base64 32
# Must match the value of PREVIEW_JWT_SECRET in apps/web/.env (the web
# side calls /api/preview/verify; signing happens only on the CMS).
PREVIEW_JWT_SECRET=


# Cross-process cache invalidation. When set, the CMS pings the
# apps/web `/api/revalidate` endpoint after operations that change
# how content renders (e.g. Media filename rename moves R2 objects
# and stale ISR pages would otherwise 404 for up to ~60s).
# Both must be set together; unset = ISR catches up on its own TTL.
# WEB_REVALIDATE_SECRET must match apps/web/.env.
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=

# ─── Careers / Brevo (career-application notifications) ────────────────────
# Brevo transactional API relays new job-application notifications (with the
# resume attached) to HR. Brevo is the careers/partner email sub-processor —
# distinct from HubSpot, which owns the lead pipeline and never receives
# careers data. When BREVO_API_KEY is unset the relay is a no-op: applications
# still save to Postgres and the resume still lands in private R2, but no HR
# email is sent (local dev / offline iteration unaffected).
BREVO_API_KEY=
# From-address for the HR notification email. Required when BREVO_API_KEY is set.
BREVO_SENDER_EMAIL=
# From-name shown on the notification email (global default / fallback).
BREVO_SENDER_NAME=CleanStart
# Per-form sender override — lets each form send from its own verified From
# identity, falling back to BREVO_SENDER_* above when unset. Each must be a
# VERIFIED sender in Brevo.
CAREERS_SENDER_EMAIL=
CAREERS_SENDER_NAME=
# Recipient for new-application notifications (resume attached). Required for
# the relay to fire; unset skips the email even when BREVO_API_KEY is set.
CAREERS_HR_EMAIL=
# Career-application + resume retention window in days. After this window the
# purge-career-applications cron hard-deletes the resume and nulls applicant
# PII. Defaults to 365 when unset.
CAREERS_RETENTION_DAYS=365
# Private R2 key prefix for uploaded resumes (kept out of the public media
# prefix so resumes are never publicly addressable). Defaults to web/resumes
# in production and dev/resumes in dev/staging when unset.
R2_RESUME_PREFIX=

# Partner form (Brevo). Two transactional templates: one for the applicant
# confirmation, one for the internal team notification. Unset template IDs ->
# code-built HTML fallback. Sends are skipped without BREVO_API_KEY.
PARTNER_USER_TEMPLATE_ID=
PARTNER_ADMIN_TEMPLATE_ID=
# Per-form sender override for partner emails (falls back to BREVO_SENDER_*).
# Must be a VERIFIED sender in Brevo.
PARTNERS_SENDER_EMAIL=
PARTNERS_SENDER_NAME=
# Recipient for the internal new-partner-inquiry notification.
PARTNERS_NOTIFY_EMAIL=

# Cookie-consent ingest — shared bearer secret for the web CMP to POST
# decisions to /api/consentLog/ingest. Must match apps/web CONSENT_INGEST_SECRET.
# Unset = the ingest endpoint returns 503 and no consent rows are written.
CONSENT_INGEST_SECRET=

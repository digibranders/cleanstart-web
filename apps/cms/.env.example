# Postgres — local dev points at infra/docker-compose.yml
DATABASE_URI=postgres://cleanstart:cleanstart@localhost:5432/cleanstart

# Payload — generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Public URL of this app (used by Payload for absolute URLs in admin UI + emails)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 (Phase B - leave blank in early dev to use local fs uploads)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Brevo (Phase E)
BREVO_API_KEY=

# Sentry (Phase G)
SENTRY_DSN=

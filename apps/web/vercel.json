{
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @cleanstart/web build",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages ../../pnpm-lock.yaml 2>/dev/null && exit 0 || exit 1",
  "git": {
    "deploymentEnabled": {
      "development": false,
      "farheen": false
    }
  }
}

{
  "name": "@cleanstart/web",
  "version": "0.0.1",
  "description": "CleanStart marketing site — Next.js 16 + Tailwind v4. Consumes @cleanstart/ui primitives and reads content from @cleanstart/cms.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "analyze": "ANALYZE=1 next build",
    "start": "next start --port 3001",
    "lint": "biome lint src",
    "lint:eslint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:eslint:count": "node scripts/lint-warn-count.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "bundle:budget": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@cleanstart/schema": "workspace:*",
    "@cleanstart/types": "workspace:*",
    "@cleanstart/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.23",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.14.0",
    "mapbox-gl": "^3.25.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.38.0",
    "next": "16.2.5",
    "node-html-markdown": "^2.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.1",
    "react-simple-maps": "^3.0.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cleanstart/config": "workspace:*",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "happy-dom": "^20.9.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}

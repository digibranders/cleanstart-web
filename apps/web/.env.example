# Public URL of the Payload CMS (apps/cms) — used by apps/web to fetch
# content via Payload REST. Local dev: http://localhost:3000.
NEXT_PUBLIC_CMS_URL=http://localhost:3000

# Optional: a server-only API key for authenticated CMS reads (drafts/previews).
# Leave blank for local dev unless you're testing draft preview flow.
CMS_API_KEY=

# Canonical public origin of this site, used for metadataBase, canonical
# URLs, OpenGraph/Twitter image URLs, and the sitemap. Set per-environment:
# production → https://www.cleanstart.com (live), preview/staging → keep unset or set explicitly.
# Unset = falls back to https://www.cleanstart.com.
NEXT_PUBLIC_SITE_URL=https://www.cleanstart.com

# Public URL of the Payload CMS (apps/cms) — used by apps/web to fetch
# content via Payload REST. Local dev: http://localhost:3000.
NEXT_PUBLIC_CMS_URL=http://cms.cleanstart.com
# ─── Preview sharing (must match values in apps/cms/.env) ─────────────────
# Server-only API key (Payload users → API key) carried on every
# draft-mode fetch so the web side can pull unpublished docs over
# REST. Issue from /admin/collections/users by creating a system
# user (e.g. preview-bot@cleanstart.com), enabling its API key, and
# copying the value here. IMPORTANT: give that user NO roles — draft
# read access comes from being authenticated (publishedOrAuthenticated
# in apps/cms access), while create/update/delete stay gated by
# isAdminOrEditor, so a role-less preview-bot is read-only by
# construction (least privilege). If unset, draft preview safely falls
# back to the PUBLISHED version (no leak, no crash).
CMS_API_KEY=
# Which collection the API-key user lives in. Defaults to "users".
CMS_API_KEY_COLLECTION=users
# Shared secret for in-admin Live Preview iframe enable URL. Must
# byte-for-byte match LIVE_PREVIEW_SECRET in apps/cms/.env.
LIVE_PREVIEW_SECRET=
# HS256 secret for shareable preview-link JWTs. Currently unused
# server-side (verification round-trips to the CMS) but reserved so
# both apps can rotate keys together if local verification is ever
# added. Must match PREVIEW_JWT_SECRET in apps/cms/.env.
PREVIEW_JWT_SECRET=

# Shared bearer token that authenticates POST /api/revalidate calls
# from the CMS (mode 1: arbitrary tags + paths). Must match
# WEB_REVALIDATE_SECRET in apps/cms/.env.
# Unset = the endpoint refuses all Bearer-token calls (503 revalidation_disabled).
WEB_REVALIDATE_SECRET=

# Body-secret token for Payload publish hooks that pop nav cache tags
# (mode 2: allow-listed tags only — community-images, resources-latest-updates,
# resources-spotlight, company-spotlight, careers-open-count).
# Set the same value in apps/cms/.env as REVALIDATE_SECRET.
REVALIDATE_SECRET=

# ─── Cloudflare Turnstile (bot protection on all public forms) ────────────
# Public site key — safe to expose client-side.
# Get it from dash.cloudflare.com → Turnstile → your widget → Site key.
# LOCAL TESTING: use Cloudflare's public always-pass test site key (works on
# localhost; pair with the test secret in apps/cms/.env):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Cookie consent (CMP) ─────────────────────────────────────────────────
# HMAC-SHA256 key used to hash visitor IP + user-agent before forwarding a
# consent decision to the CMS ConsentLog (data minimisation — no raw PII is
# stored). Generate with: openssl rand -base64 32
CONSENT_LOG_HMAC_SECRET=
# Shared bearer secret for POST {NEXT_PUBLIC_CMS_URL}/api/consentLog/ingest.
# Must byte-for-byte match CONSENT_INGEST_SECRET in apps/cms/.env. When either
# this or CONSENT_LOG_HMAC_SECRET is unset, the banner still works fully —
# the server-side audit forward is simply skipped (best-effort).
CONSENT_INGEST_SECRET=
